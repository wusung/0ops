{{ define "blog-post" }}{{ template "layout" . }}{{ end }}
{{ define "content" }}
<article class="post wrap">
  <input type="radio" name="lang" id="lang-zh" class="lang-radio" checked>
  <input type="radio" name="lang" id="lang-en" class="lang-radio">
  <p class="lang-switch"><label for="lang-zh">中文</label> · <label for="lang-en">English</label></p>

  <section id="zh" class="post-lang" lang="zh-Hant">
    {{ .ZHHTML }}
  </section>

  <section id="en" class="post-lang" lang="en">
    {{ .ENHTML }}
  </section>

  <p class="back"><a href="{{ .RootPath }}blog/">← All posts / 所有文章</a></p>
</article>
{{ end }}
