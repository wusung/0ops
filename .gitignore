# env / secrets
.env
.env.*
!.env.example

# 個人本機 compose 覆寫（spec § 12）
compose.override.yaml
compose.override.yml
!compose.override.yaml.example

# build artifacts
/bin/
/build/
/dist/
/tmp/
/out/
*.log

# editor
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code / Claire agent 本地工作區狀態
.claude/
.claire/

# Go
*.test
*.out
coverage.*
.cache/
.worktrees/
.task-sessions/

# OS junk
.DS_Store
Thumbs.db

# Local example repos' own git dirs (initialized by examples/*/bootstrap.sh
# per ADR-0012; the outer 0ops repo must not track these).
examples/*/.git/
examples/*/node_modules/
