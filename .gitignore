# env / secrets
.env
.env.*
!.env.example

# 個人本機 compose 覆寫（spec § 12）
compose.override.yaml
compose.override.yml
!compose.override.yaml.example

# build artifacts (root)
/bin/
/build/
/dist/
/tmp/
/out/
/cli
*.log

# build artifacts (src/ — Go module root；goreleaser 落 src/dist/、
# .air.toml 在 container 內寫 src/tmp/、go build host fallback 仍走 bin/)
/src/bin/
/src/build/
/src/dist/
/src/tmp/
/src/out/

# editor
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code / Claire agent 本地工作區狀態
.claude/
.claire/

# Go
*.test
*.out
coverage.*
.cache/
.worktrees/
.task-sessions/

# OS junk
.DS_Store
Thumbs.db

# Local example repos' own git dirs (initialized by examples/*/bootstrap.sh
# per ADR-0012; the outer 0ops repo must not track these).
examples/*/.git/
examples/*/node_modules/
