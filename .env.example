# Postgres
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops_dev_pw
POSTGRES_DB=ops
DATABASE_URL=postgres://ops:ops_dev_pw@db:5432/ops?sslmode=disable

# 0ops-server
OPS_LISTEN_ADDR=:8080
# 對外暴露的 host port（容器內固定 8080；遇 host 衝突可改）
OPS_HOST_PORT=8080
OPS_LOG_LEVEL=debug
OPS_CALLBACK_SECRET=dev-callback-secret-change-me

# 外部整合（dev 預設留空，需要時填寫）
OPS_GITHUB_APP_ID=
OPS_GITHUB_APP_PRIVATE_KEY_PATH=
OPS_CLOUDFLARE_API_TOKEN=
OPS_CLOUDFLARE_ACCOUNT_ID=

# Local-file-repo dev mode（ADR-0012）。
# Production 必須維持 OPS_ENV=production 且下列三者皆為空，server boot
# 偵測衝突會立即 panic（internal/shared/runtime.AssertProductionSafe）。
OPS_ENV=development
LOCAL_FILE_REPO_ENABLED=true
LOCAL_BUILD_ENABLED=true
LOCAL_REGISTRY=localhost:5000
