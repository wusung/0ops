# production-deployment spec § 5.1 — single source of truth for prod bootstrap.
# 複製為 .env.prod，填值後 ./manage.sh prod-up 會自動載入。
# 警告：.env.prod 含明文 secret，絕對不可 commit。已加入 .gitignore。

# === target host ===
PROD_HOST=user@1.2.3.4                          # ssh target
PROD_SSH_KEY=$HOME/.ssh/id_ed25519              # 私鑰路徑
PROD_KUBECONFIG_LOCAL=$HOME/.kube/0ops-prod     # local 寫入 kubeconfig 路徑

# === domain ===
PROD_BASE_DOMAIN=winshare.tw
PROD_API_HOST=api.winshare.tw
PROD_DEMO_HOST=nextdemo.winshare.tw

# === Cloudflare Tunnel ===
# https://one.dash.cloudflare.com → Networks → Tunnels → Create → copy token
CF_TUNNEL_TOKEN=

# === GitHub OAuth App (production) ===
# 建議：./manage.sh prod-setup-oauth 互動式建立並寫入此檔
# （runbook docs/runbooks/production-oauth-setup.md）。手動填亦可：
#   https://github.com/settings/developers → New OAuth App
#   Authorization callback URL: https://$PROD_API_HOST/v1/auth/oauth2/callback
#   Enable Device Flow: 勾選
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://api.winshare.tw/v1/auth/oauth2/callback

# === image ===
# GitHub Release tag (https://github.com/wusung/0ops/releases)
OPS_IMAGE_TAG=v0.1.1
OPS_IMAGE_REPO=ghcr.io/winshare/ops-server

# === Postgres ===
PG_SUPERUSER_PASSWORD=
PG_REPLICA_PASSWORD=

# === observability (optional) ===
GRAFANA_ADMIN_PASSWORD=

# === argocd ===
ARGOCD_REPO_URL=https://github.com/wusung/0ops.git
ARGOCD_TARGET_REVISION=main

# === GHA self-hosted runner (optional; spec docs/features/self-hosted-runner/) ===
# 用 ./manage.sh prod-install-runner 安裝；切換經由：
#   gh variable set GHA_RUNNER_LABEL --repo $GHA_REPO --body $GHA_RUNNER_LABEL
# 不設這些 → workflow 仍走 GitHub-hosted ubuntu-latest（fallback）。
GHA_REPO=wusung/0ops
GHA_RUNNER_NAME=0ops-prod-1
GHA_RUNNER_LABEL=0ops-builder
GHA_RUNNER_VERSION=2.319.1
